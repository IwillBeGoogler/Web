{
  "name": "system-design-diagram",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted system design diagram editor with 2,000+ real logos, cluster profiles and smart routing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakhod1r/system-design-diagram.git"
  },
  "homepage": "https://github.com/bakhod1r/system-design-diagram",
  "bugs": "https://github.com/bakhod1r/system-design-diagram/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:watch": "vitest",
    "prices:update": "server/node_modules/.bin/tsx scripts/prices/update-prices.ts",
    "icons:audit": "node scripts/icons-audit.ts",
    "icons:gen": "node scripts/gen-icons.mjs",
    "logos:fetch": "node scripts/fetch-logos.mjs",
    "qa:screenshots": "node scripts/screenshots.ts",
    "e2e": "vite build && playwright test",
    "e2e:update": "vite build && playwright test --update-snapshots",
    "bench:fixture": "node scripts/gen-bench-fixture.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@typescript/typescript6": "6.0.2",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lib0": "0.2.119",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "mqtt": "5.16.1",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "three": "0.170.0",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yaml": "2.9.1",
    "yjs": "13.6.33",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.92",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
