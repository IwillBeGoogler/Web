{
  "name": "iblog-client-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build && tsc --noEmit",
    "preview": "bunx --bun vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:editor": "tsc -p type-tests/tsconfig.json",
    "test": "vitest run && (cd editor && vitest run)",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "playwright test",
    "e2e:diagrams": "playwright test e2e/diagrams.spec.ts --project=desktop",
    "test:editor": "(cd editor && vitest run)",
    "typecheck:editor-src": "tsc --noEmit -p editor/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
